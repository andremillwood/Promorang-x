# Public values embedded in the app bundle. Never place service-role or secret keys here.
EXPO_PUBLIC_API_URL=https://api.promorang.co
EXPO_PUBLIC_WEB_URL=https://promorang.co
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_ENABLE_DEMO_LOGIN=false

# Optional: the app fetches the Stripe publishable key from /api/stripe/config when omitted.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
