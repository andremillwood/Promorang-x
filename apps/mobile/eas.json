{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.promorang.co",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGIN": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.promorang.co",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGIN": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
