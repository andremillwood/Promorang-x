{
  "name": "promorang-x",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "test:shared": "npm test --workspace packages/shared",
    "inventory:kingston": "node scripts/inventory/kingston-pilot.mjs",
    "inventory:jamaica": "node scripts/inventory/jamaica-national.mjs",
    "inventory:jamaica-events": "node scripts/events/jamaica-events.mjs",
    "inventory:city": "node scripts/inventory/city-pilot.mjs",
    "test:inventory": "node --test scripts/inventory/*.test.mjs",
    "qa:commerce": "node scripts/audit-experience-commerce.cjs",
    "qa:commerce:activate": "node scripts/activate-experience-commerce-qa.cjs",
    "deploy:web": "npx vercel --prod",
    "deploy:backend": "cd backend && npx vercel --prod",
    "deploy": "npm run deploy:web && npm run deploy:backend"
  },
  "description": "Promorang full-stack application with React frontend and API backend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andremillwood/Promorang-x.git"
  },
  "keywords": [
    "react",
    "vite",
    "vercel",
    "api",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "dependencies": {
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-worklets": "0.5.1"
  },
  "overrides": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  }
}
